# Copy to `.env` and fill in real values.

# Sign in at https://seclai.com → API Keys (sidebar) → Create API key
SECLAI_API_KEY=your_api_key_here

# The YouTube thumbnail chat agent. `npm run setup -- --create` makes one and
# fills this in; or create it from the gallery in the Seclai app and paste its id.
SECLAI_AGENT_ID=

# Signs the anonymous browser cookie that ties sessions to a browser.
# `npm run setup -- --apply` (or --create) generates one; or use: openssl rand -hex 32
SESSION_SECRET=change_me

# Optional: where the SQLite database and uploaded photos are kept.
DATA_DIR=./data

# Optional: server log detail. debug | info (default) | warn | error | silent.
# `debug` also logs every streamed token, chunk and keepalive.
LOG_LEVEL=info

# Optional: force the session cookie's Secure flag. By default it's Secure only
# when the request is HTTPS. Set to true behind a proxy that terminates TLS.
# COOKIE_SECURE=true
