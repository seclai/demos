# Copy to `.env` and fill in real values.

# https://app.seclai.com → Settings → API Keys
SECLAI_API_KEY=your_api_key_here

# The YouTube thumbnail chat agent. `npm run setup -- --create` makes one and
# prints its id; or create it from the gallery in the Seclai app.
SECLAI_AGENT_ID=

# Signs the anonymous browser cookie that ties sessions to a browser.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change_me

# Optional: where the SQLite database and uploaded photos are kept.
DATA_DIR=./data

# Optional: server log detail. debug | info (default) | warn | error | silent.
# `debug` also logs every streamed token, chunk and keepalive.
LOG_LEVEL=info
