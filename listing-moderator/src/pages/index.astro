---
import ListingModerator from '../components/ListingModerator.tsx';
import '../styles/global.css';

const title = 'Listing Moderator — powered by Seclai';
const description =
  'Upload a marketplace listing photo and check it against listing policies — approve, review, or reject with violations and quality score.';
// Absolute URLs resolved from the incoming request, so social cards work on any deploy domain.
const pageUrl = new URL(Astro.url.pathname, Astro.url).href;
const ogImage = new URL('/og.png', Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1b22" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <ListingModerator client:load />

    <style is:global>
      :root {
        --accent: #4640e0;
        --accent-hover: #322fc4;
        --accent-soft: #eeedfb;
        --bg: #f6f5f1;
        --surface: #ffffff;
        --surface-2: #fbfbf8;
        --ink: #1a1b22;
        --ink-2: #2a2b33;
        --ink-soft: #5b5c66;
        --ink-muted: #9a9a90;
        --ink-faint: #b4b4aa;
        --line: #e6e5dd;
        --line-2: #e2e1d8;
        --line-strong: #d2d1c7;
        --good: #16a34a;
        --warn: #d97706;
        --bad: #dc2626;
        --serif: 'Instrument Serif', Georgia, serif;
        --font: 'Hanken Grotesk', -apple-system, system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', monospace;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; height: 100%; }
      body {
        font-family: var(--font);
        background: var(--bg);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      @keyframes mp-spin { to { transform: rotate(360deg); } }
      @keyframes mp-fade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
      @keyframes lm-scan { 0% { transform: translateY(0); } 100% { transform: translateY(230px); } }
      @keyframes lm-pulse { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-thumb { background: var(--line); border-radius: 8px; border: 3px solid var(--bg); }

      .app { min-height: 100vh; display: flex; flex-direction: column; background: var(--bg); }

      /* ---- Top bar ---- */
      .topbar {
        position: sticky; top: 0; z-index: 30;
        background: rgba(246,245,241,0.82); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid transparent;
        transition: border-color .2s ease;
      }
      .topbar.scrolled { border-bottom-color: var(--line); }
      .topbar-inner {
        max-width: 1240px; margin: 0 auto; padding: 14px 0;
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
      }
      .brand { display: flex; align-items: center; gap: 13px; }
      .brand-mark { width: 34px; height: 34px; display: block; flex: 0 0 auto; }
      .brand-title { font-size: 16px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink); white-space: nowrap; }

      .gh-btn {
        display: inline-flex; align-items: center; gap: 7px;
        height: 34px; padding: 0 13px; border-radius: 9px;
        border: 1px solid var(--line-2); background: var(--surface); color: #3a3b45;
        font-family: var(--font); font-size: 13.5px; font-weight: 600;
        text-decoration: none; white-space: nowrap; cursor: pointer;
        transition: color .15s, background .15s, border-color .15s;
      }
      .gh-btn:hover, .gh-btn:focus-visible {
        background: var(--surface-2); border-color: var(--line-strong); outline: none;
      }
      .gh-btn svg { display: block; }

      /* ---- Hero ---- */
      .hero { position: relative; text-align: center; padding: 78px 32px 30px; overflow: hidden; }
      .hero-bg {
        position: absolute; inset: 0; pointer-events: none;
        background-image: radial-gradient(circle, #e1e0d6 1.1px, transparent 1.1px);
        background-size: 22px 22px;
        -webkit-mask-image: radial-gradient(ellipse 60% 80% at 50% 30%, #000 0%, transparent 75%);
        mask-image: radial-gradient(ellipse 60% 80% at 50% 30%, #000 0%, transparent 75%);
      }
      .hero-inner { position: relative; max-width: 1240px; margin: 0 auto; }
      .hero-title {
        font-family: var(--serif); font-weight: 400; font-size: 74px; line-height: 1.0;
        letter-spacing: -0.01em; margin: 0 0 22px; color: #16171e;
      }
      .hero-em { font-style: italic; }
      .hero-sub { max-width: 520px; margin: 0 auto; font-size: 17px; line-height: 1.6; color: var(--ink-soft); }
      @media (max-width: 640px) {
        .topbar-inner { padding: 12px 16px; }
        .checks-btn span, .gh-btn span { display: none; }
        .checks-btn, .gh-btn { padding: 0 10px; }
        .hero { padding: 40px 20px 20px; }
        .hero-title { font-size: 42px; }
        .hero-sub { font-size: 14.5px; }
        .hero-title br { display: none; }
      }

      /* ---- Main / layout ---- */
      .main { flex: 1; min-height: 0; display: flex; justify-content: center; padding: 20px 32px 90px; }
      .layout {
        width: 100%; max-width: 1240px;
        display: grid; grid-template-columns: minmax(360px, 410px) 1fr; gap: 22px; align-items: start;
      }

      /* ---- Site footer ---- */
      .site-footer { flex: none; border-top: 1px solid var(--line); background: rgba(246,245,241,0.6); }
      .site-footer-inner {
        max-width: 1240px; margin: 0 auto; padding: 22px 32px;
        display: flex; align-items: center; justify-content: center; gap: 10px;
        font-size: 13px; color: var(--ink-muted);
      }
      .site-footer-brand { font-weight: 600; color: var(--ink-soft); }
      .site-footer-dot { color: var(--line-strong); }
      .site-footer-link {
        color: var(--ink-soft); text-decoration: none; font-weight: 500;
        transition: color .15s;
      }
      .site-footer-link:hover, .site-footer-link:focus-visible { color: var(--accent); outline: none; }
      @media (max-width: 640px) {
        .site-footer-inner { padding: 20px 16px; font-size: 12.5px; }
      }

      .panel {
        background: var(--surface); border: 1px solid var(--line); border-radius: 18px;
        box-shadow: 0 1px 2px rgba(20,20,15,0.03), 0 8px 24px -18px rgba(20,20,15,0.18);
      }
      .panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
      .panel-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.13em; text-transform: uppercase; color: var(--ink-muted); }
      .panel-step { font-family: var(--mono); font-size: 11px; color: var(--ink-faint); }

      .input-panel { padding: 22px; display: flex; flex-direction: column; }

      /* ---- Dropzone / preview ---- */
      .drop {
        border: 1.5px dashed var(--line-strong); background: var(--surface-2); border-radius: 13px;
        padding: 34px 20px; display: flex; flex-direction: column; align-items: center; cursor: pointer;
        transition: border-color .15s, background .15s;
      }
      .drop:hover, .drop:focus-visible { border-color: var(--accent); outline: none; }
      .drop.over { border-color: var(--accent); background: var(--accent-soft); }
      .drop-icon { width: 46px; height: 46px; border-radius: 12px; background: var(--accent-soft); display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
      .drop-title { font-size: 14.5px; font-weight: 600; color: var(--ink-2); }
      .drop-sub { font-size: 13px; color: #8a8a80; margin-top: 3px; }
      .drop-link { color: var(--accent); font-weight: 600; }

      .preview { position: relative; border-radius: 13px; overflow: hidden; border: 1px solid var(--line); background: #101119; height: 240px; }
      .preview-img { width: 100%; height: 100%; background-size: contain; background-repeat: no-repeat; background-position: center; }
      .scan { position: absolute; inset: 0; }
      .scan-tint { position: absolute; inset: 0; background: rgba(70,64,224,0.08); }
      .scan-line {
        position: absolute; left: 0; right: 0; top: 0; height: 2px;
        background: linear-gradient(90deg, transparent, #7c77ff, transparent);
        box-shadow: 0 0 18px 3px rgba(124,119,255,0.7);
        animation: lm-scan 1.15s ease-in-out infinite alternate;
      }
      .scan-badge {
        position: absolute; left: 12px; top: 12px; display: inline-flex; align-items: center; gap: 7px;
        font-family: var(--mono); font-size: 11px; color: #fff; background: rgba(16,17,25,0.7);
        padding: 5px 10px; border-radius: 7px; backdrop-filter: blur(4px);
      }
      .scan-pulse { width: 8px; height: 8px; border-radius: 50%; background: #7c77ff; animation: lm-pulse 1s infinite; }
      .preview-clear {
        position: absolute; top: 10px; right: 10px; width: 28px; height: 28px; border-radius: 8px; border: none;
        background: rgba(16,17,25,0.72); color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;
        backdrop-filter: blur(4px);
      }
      .preview-name {
        position: absolute; left: 12px; bottom: 12px; font-family: var(--mono); font-size: 11px; color: #e8e8f0;
        background: rgba(16,17,25,0.72); border-radius: 6px; padding: 4px 9px; max-width: 70%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        backdrop-filter: blur(4px);
      }

      /* ---- Caption + run ---- */
      .field-label { display: block; font-family: var(--mono); font-size: 11px; letter-spacing: 0.13em; text-transform: uppercase; color: var(--ink-muted); margin: 20px 0 7px; }
      .field-optional { text-transform: none; letter-spacing: 0; color: #a0a196; }
      .caption-input {
        width: 100%; padding: 11px 13px; border: 1px solid var(--line-2); border-radius: 10px;
        font-family: var(--font); font-size: 14px; color: var(--ink); outline: none; background: var(--surface-2);
        transition: border-color .15s, background .15s, box-shadow .15s;
      }
      .caption-input:focus { border-color: var(--accent); background: var(--surface); box-shadow: 0 0 0 3px rgba(70,64,224,0.12); }
      .field-helper { margin: 8px 2px 0; font-size: 12px; line-height: 1.5; color: var(--ink-muted); }

      .run-btn {
        margin-top: 18px; padding: 13px; width: 100%; background: var(--accent); color: #fff; border: none; border-radius: 11px;
        font-family: var(--font); font-size: 14.5px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
        box-shadow: 0 1px 3px rgba(70,64,224,0.35); transition: background .15s;
      }
      .run-btn:hover:not(:disabled) { background: var(--accent-hover); }
      .run-btn:disabled { opacity: 0.55; cursor: not-allowed; }
      .run-spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,0.35); border-top-color: #fff; border-radius: 50%; display: inline-block; animation: mp-spin .7s linear infinite; }

      /* ---- Samples ---- */
      .samples { margin-top: 22px; padding-top: 20px; border-top: 1px solid #efeee7; }
      .samples-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 12px; }
      .samples-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
      .sample {
        display: flex; align-items: center; gap: 10px; text-align: left; padding: 9px;
        background: var(--surface-2); border: 1px solid var(--line); border-radius: 11px; cursor: pointer;
        transition: border-color .15s, background .15s;
      }
      .sample:hover:not(:disabled) { border-color: #c9c8be; background: #f7f6f1; }
      .sample:disabled { opacity: 0.6; cursor: not-allowed; }
      .sample-thumb {
        position: relative; flex: 0 0 auto; width: 40px; height: 40px; border-radius: 8px;
        background-color: #eeede6; background-size: cover; background-position: center;
      }
      .sample-badge { position: absolute; right: -3px; top: -3px; width: 11px; height: 11px; border-radius: 50%; border: 2px solid var(--surface-2); }
      .sample-meta { min-width: 0; }
      .sample-name { display: block; font-family: var(--mono); font-size: 11.5px; color: #3a3b45; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .sample-tag { display: block; font-size: 11px; color: var(--ink-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

      /* ---- Output panel ---- */
      .output-panel { display: flex; flex-direction: column; min-height: 600px; }
      .output-header { flex: none; display: flex; align-items: center; justify-content: space-between; padding: 18px 22px; border-bottom: 1px solid #efeee7; }
      .tabs { display: flex; background: #f1f0e9; border: 1px solid #e4e3da; border-radius: 9px; padding: 3px; gap: 2px; }
      .tab {
        padding: 6px 16px; border: none; border-radius: 6px; font-family: var(--font); font-size: 12.5px; font-weight: 600;
        cursor: pointer; background: transparent; color: var(--ink-soft);
      }
      .tab-mono { font-family: var(--mono); font-size: 12px; font-weight: 500; }
      .tab.active { background: var(--surface); color: var(--ink); box-shadow: 0 1px 2px rgba(20,20,15,0.08); }

      .output-body { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 22px; }

      /* ---- Idle / error state ---- */
      .idle { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 20px; }
      .idle-icon { width: 56px; height: 56px; border-radius: 15px; background: #f4f3ec; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; margin-bottom: 20px; }
      .idle-icon.error { background: #fef2f2; border-color: #f5d9d6; }
      .idle-title { font-size: 16px; font-weight: 700; color: var(--ink-2); margin-bottom: 6px; }
      .idle-sub { max-width: 340px; font-size: 13.5px; line-height: 1.6; color: #8a8a80; margin: 0 0 22px; }
      .idle-checks { width: 100%; max-width: 380px; text-align: left; background: var(--surface-2); border: 1px solid #eeede6; border-radius: 12px; padding: 6px; }
      .idle-check { display: flex; align-items: center; gap: 10px; padding: 9px 11px; }
      .idle-check + .idle-check { border-top: 1px solid #f2f1ea; }
      .idle-dot { flex: 0 0 auto; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
      .idle-name { font-size: 13px; color: #4a4b55; font-weight: 600; }
      .idle-eg { margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--ink-faint); }
      .checks-open-link {
        margin-top: 18px; border: none; background: none; cursor: pointer;
        font-family: var(--font); font-size: 13px; font-weight: 600; color: var(--accent);
      }
      .checks-open-link:hover { color: var(--accent-hover); text-decoration: underline; }
      .json-empty { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; font-family: var(--mono); font-size: 13px; color: var(--ink-faint); }

      /* ---- Running state ---- */
      .running { animation: mp-fade .3s ease both; }
      .running-head { display: flex; align-items: center; gap: 12px; padding: 16px 18px; background: var(--surface-2); border: 1px solid #eeede6; border-radius: 14px; margin-bottom: 18px; }
      .running-spin { flex: 0 0 auto; width: 22px; height: 22px; border: 2.5px solid #e0dff7; border-top-color: var(--accent); border-radius: 50%; display: inline-block; animation: mp-spin .7s linear infinite; }
      .running-title { font-size: 14.5px; font-weight: 700; color: var(--ink-2); }
      .running-sub { font-size: 12.5px; color: var(--ink-muted); }
      .running-list { display: flex; flex-direction: column; }
      .run-check { display: flex; align-items: center; gap: 12px; padding: 11px 6px; border-bottom: 1px solid #f4f3ec; animation: lm-pulse 1.4s ease-in-out infinite; }
      .run-glyph { width: 22px; height: 22px; border-radius: 7px; background: #f1f0e9; border: 1.5px solid var(--line-2); flex: 0 0 auto; }
      .run-check-label { font-size: 13.5px; font-weight: 600; color: #6a6b74; }

      /* ---- Card view ---- */
      .card-view { animation: mp-fade .35s ease both; }
      .verdict { display: flex; align-items: center; gap: 15px; border: 1px solid; border-radius: 15px; padding: 18px 20px; }
      .verdict-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
      .verdict-body { flex: 1; min-width: 0; }
      .verdict-top { display: flex; align-items: center; gap: 10px; }
      .verdict-label { font-size: 19px; font-weight: 800; letter-spacing: -0.01em; }
      .verdict-chip { font-family: var(--mono); font-size: 11px; padding: 3px 8px; border-radius: 6px; }
      .verdict-sub { font-size: 13.5px; color: var(--ink-soft); margin-top: 3px; }

      .checks-section { margin-top: 22px; }
      .section-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.11em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 10px; }
      .muted { color: #c4c4ba; }

      .checks-list { border: 1px solid #eeede6; border-radius: 13px; overflow: hidden; }
      .check-row { display: flex; align-items: flex-start; gap: 12px; padding: 13px 15px; }
      .check-row + .check-row { border-top: 1px solid #f4f3ec; }
      .check-glyph { width: 22px; height: 22px; border-radius: 7px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; flex: 0 0 auto; margin-top: 1px; }
      .check-main { min-width: 0; flex: 1; }
      .checks-list .check-top { display: flex; align-items: center; gap: 8px; }
      .checks-list .check-label { font-size: 13.5px; font-weight: 700; color: var(--ink-2); line-height: 1.3; }
      .check-status { font-family: var(--mono); font-size: 10.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
      .check-note { font-size: 12.5px; line-height: 1.5; color: #7a7b84; margin-top: 2px; }

      /* ---- JSON view (light) ---- */
      .json-dark { position: relative; overflow: auto; animation: mp-fade .3s ease both; }
      .json-copy {
        position: absolute; top: 0; right: 0; z-index: 1;
        font-family: var(--font); font-size: 11.5px; font-weight: 600;
        color: var(--ink-soft); background: var(--surface); border: 1px solid var(--line-2);
        border-radius: 7px; padding: 5px 11px; cursor: pointer; transition: background .15s, border-color .15s;
      }
      .json-copy:hover { background: var(--surface-2); border-color: var(--line-strong); }
      .json { font-family: var(--mono); font-size: 12.5px; line-height: 1.65; color: var(--ink-2); }
      .json-line { white-space: pre-wrap; word-break: break-word; }
      .stream-caret {
        display: inline-block; width: 7px; height: 14px; margin-left: 1px;
        background: #7c77ff; vertical-align: text-bottom; animation: mp-blink 1s steps(2) infinite;
      }
      @keyframes mp-blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

      /* ---- Footer ---- */
      .output-footer {
        flex: none; border-top: 1px solid #efeee7; padding: 14px 22px; display: flex; align-items: center; justify-content: space-between; gap: 10px;
        background: var(--surface-2); border-radius: 0 0 18px 18px;
      }
      .footer-meta { display: flex; align-items: center; gap: 14px; font-family: var(--mono); font-size: 11.5px; color: #8a8a80; flex-wrap: wrap; }
      .ok { display: inline-flex; align-items: center; gap: 6px; }
      .ok-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--good); }
      .ok-code { color: var(--good); font-weight: 600; }
      .footer-clear {
        flex: none; font-family: var(--font); font-size: 12.5px; font-weight: 600;
        color: #4a4b55; background: var(--surface); border: 1px solid var(--line-2);
        border-radius: 8px; padding: 7px 14px; cursor: pointer; transition: color .15s, border-color .15s, background .15s;
      }
      .footer-clear:hover { background: #f7f6f1; border-color: #c9c8be; }
      .dot-sep { color: var(--line-strong); }

      /* ---- Checks drawer ---- */
      .topbar-actions { display: flex; align-items: center; gap: 10px; }
      .checks-btn { cursor: pointer; font-family: var(--font); }
      .checks-btn.active { color: #fff; background: var(--accent); border-color: var(--accent); box-shadow: 0 1px 3px rgba(79,70,229,0.35); }
      .checks-btn.active:hover { color: #fff; background: var(--accent-hover); border-color: var(--accent-hover); }
      .checks-btn svg { display: block; }

      .drawer-backdrop {
        position: fixed; inset: 0; background: rgba(15,23,42,0.35); z-index: 40;
        opacity: 0; visibility: hidden; transition: opacity .25s ease, visibility .25s ease;
      }
      .drawer-backdrop.open { opacity: 1; visibility: visible; }
      .drawer {
        position: fixed; top: 0; right: 0; height: 100%; width: 400px; max-width: 90vw; z-index: 50;
        background: var(--surface); border-left: 1px solid var(--line);
        display: flex; flex-direction: column;
        transform: translateX(100%); transition: transform .28s cubic-bezier(.2,.8,.2,1), box-shadow .28s ease;
      }
      .drawer.open { transform: translateX(0); box-shadow: -20px 0 50px -24px rgba(15,23,42,0.35); }
      .drawer-head {
        flex: none; display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
        padding: 20px 22px; border-bottom: 1px solid var(--line);
      }
      .drawer-title { font-size: 16px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink); }
      .drawer-sub { margin-top: 4px; font-size: 12.5px; color: var(--ink-soft); }
      .drawer-close {
        flex: none; width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--line);
        background: var(--surface); color: var(--ink-muted); cursor: pointer; font-size: 13px;
        display: flex; align-items: center; justify-content: center; transition: color .15s, background .15s, border-color .15s;
      }
      .drawer-close:hover { color: var(--ink); background: #f8fafc; border-color: var(--line-strong); }
      .drawer-body { flex: 1; min-height: 0; overflow-y: auto; padding: 18px 22px 28px; }
      .drawer-legend {
        margin: 0 0 16px; font-size: 12.5px; line-height: 1.7; color: var(--ink-soft);
      }
      .drawer-legend strong { color: var(--ink); font-weight: 600; }
      .drawer-group { margin-bottom: 18px; }
      .drawer-group:last-child { margin-bottom: 0; }
      .drawer-group-head {
        font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
        color: var(--ink-muted); margin-bottom: 10px;
      }
      .drawer-list { display: flex; flex-direction: column; gap: 8px; }
      .check {
        display: flex; align-items: flex-start; gap: 12px;
        border: 1px solid var(--line); border-radius: 10px; padding: 11px 13px; background: var(--surface);
      }
      .check-tier {
        flex: none; font-family: var(--mono); font-size: 10px; font-weight: 600;
        letter-spacing: 0.03em; text-transform: uppercase; border-radius: 6px; padding: 3px 7px;
        width: 64px; text-align: center; margin-top: 1px;
      }
      .check-body { min-width: 0; }
      .check-top { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
      .check-label { font-size: 13px; font-weight: 600; color: var(--ink); line-height: 1.3; }
      .check-id { font-family: var(--mono); font-size: 11px; color: var(--ink-muted); }
      .check-examples { font-size: 12px; color: var(--ink-soft); line-height: 1.45; margin-top: 3px; }

      @media (max-width: 860px) {
        .app { height: auto; min-height: 100vh; overflow: visible; }
        .main { padding: 20px 20px 60px; }
        .layout { grid-template-columns: 1fr; }
        .output-panel { min-height: 460px; }
      }
    </style>
  </body>
</html>
